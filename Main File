    def _darken(self, hex_color, factor=0.8):
        hex_color = hex_color.lstrip('#')
        if len(hex_color) == 3:
            hex_color = ''.join(c*2 for c in hex_color)
        r = int(hex_color[0:2], 16)
        g = int(hex_color[2:4], 16)
        b = int(hex_color[4:6], 16)
        r = int(r * factor)
        g = int(g * factor)
        b = int(b * factor)
        return f"#{r:02x}{g:02x}{b:02x}"

    def export_to_desktop(self):
        if not self.temp_dir or not self.skins_data:
            messagebox.showwarning(self.lang["warning"], self.lang["export_warning"])
            return

        desktop = os.path.expanduser("~/Desktop")
        if not os.path.exists(desktop):
            desktop = os.path.expanduser("~")

        pack_name = self._safe_folder_name(self._get_pack_display_name())
        default_filename = f"{pack_name}.mcpack"

        save_path = filedialog.asksaveasfilename(
            title="Save .mcpack File",
            initialdir=desktop,
            initialfile=default_filename,
            filetypes=[("Minecraft Skin Pack", "*.mcpack")]
        )
        if not save_path:
            return
        if not save_path.lower().endswith(".mcpack"):
            save_path += ".mcpack"

        try:
            with zipfile.ZipFile(save_path, 'w', zipfile.ZIP_DEFLATED) as zip_file:
                for root_dir, _, files in os.walk(self.temp_dir):
                    for file in files:
                        full_path = os.path.join(root_dir, file)
                        rel_path = os.path.relpath(full_path, self.temp_dir)
                        zip_file.write(full_path, rel_path)
            messagebox.showinfo(self.lang["export_success"], self.lang["export_success_msg"].format(save_path))
        except Exception as e:
            messagebox.showerror(self.lang["export_error"], self.lang["export_error_msg"].format(e))

    def create_new_pack(self):
        if self.temp_dir and os.path.isdir(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)
        self.temp_dir = tempfile.mkdtemp(prefix="mcpack_new_")
        self.skins_data = []
        self.loaded_pack_path = "NewPack"
        self.generate_new_manifest("My New Skin Pack")
        self.save_skins_json()
        self._update_pack_label()
        self.render_skins()
        messagebox.showinfo(self.lang["new_pack_created"], self.lang["new_pack_msg"])

    def add_skin(self):
        if not self.temp_dir:
            messagebox.showwarning(self.lang["warning"], self.lang["open_pack_first"])
            return
        png_path = filedialog.askopenfilename(title="Select Skin PNG", filetypes=[("PNG Image", "*.png")])
        if not png_path:
            return
        skin_name = simpledialog.askstring(self.lang["skin_name_prompt"], self.lang["skin_name_prompt"])
        if not skin_name:
            return
        is_slim = messagebox.askyesno(self.lang["model_question"], self.lang["model_question"])
        geometry = "geometry.humanoid.customSlim" if is_slim else "geometry.humanoid.custom"

        safe_name = "".join(c for c in skin_name if c.isalnum() or c in " _-").strip().replace(" ", "_")
        if not safe_name:
            safe_name = "skin"
        filename = f"{safe_name}_{uuid.uuid4().hex[:4]}.png"
        target_path = os.path.join(self.temp_dir, filename)
        shutil.copy2(png_path, target_path)

        new_skin = {
            "geometry": geometry,
            "name": skin_name,
            "localization_name": skin_name,
            "texture": filename,
            "type": "free"
        }
        self.skins_data.append(new_skin)
        self.save_skins_json()
        self.render_skins()
        self._update_pack_label()

    def rename_pack(self):
        if not self.temp_dir:
            messagebox.showwarning(self.lang["warning"], "Please open a pack first!")
            return
        current_name = self._get_pack_display_name()
        new_name = simpledialog.askstring(self.lang["rename_pack_title"], self.lang["rename_pack_msg"], initialvalue=current_name)
        if new_name and new_name != current_name:
            self.generate_new_manifest(new_name)
            self.save_skins_json()
            self._update_pack_label()
            messagebox.showinfo(self.lang["rename_success"], self.lang["rename_success_msg"].format(new_name))

    def rename_skin(self, idx):
        skin = self.skins_data[idx]
        old_name = skin.get("localization_name") or skin.get("name") or f"skin_{idx}"
        new_name = simpledialog.askstring(self.lang["rename_skin_title"], self.lang["rename_skin_msg"], initialvalue=old_name)
        if new_name and new_name != old_name:
            skin["localization_name"] = new_name
            if "name" in skin:
                skin["name"] = new_name
            self.save_skins_json()
            self.render_skins()

    def generate_new_manifest(self, pack_name):
        manifest_path = os.path.join(self.temp_dir, "manifest.json")
        uuid1 = str(uuid.uuid4())
        uuid2 = str(uuid.uuid4())
        self.manifest = {
            "format_version": 1,
            "header": {
                "name": pack_name,
                "uuid": uuid1,
                "version": [1, 0, 0]
            },
            "modules": [
                {
                    "type": "skin_pack",
                    "uuid": uuid2,
                    "version": [1, 0, 0]
                }
            ]
        }
        with open(manifest_path, "w", encoding="utf-8") as f:
            json.dump(self.manifest, f, indent=4, ensure_ascii=False)

    def save_skins_json(self):
        if not self.temp_dir:
            return
        skins_json_path = os.path.join(self.temp_dir, "skins.json")
        pack_name = self._get_pack_display_name()
        data = {
            "skins": self.skins_data,
            "serialize_name": pack_name,
            "localization_name": pack_name
        }
        with open(skins_json_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=4, ensure_ascii=False)

    def on_drop(self, event):
        raw = event.data.strip()
        if raw.startswith("{"):
            path = raw.split("}")[0].lstrip("{")
        else:
            path = raw.split()[0]
        if path:
            self.try_load(path)

    def open_mcpack(self):
        path = filedialog.askopenfilename(
            title="Select .mcpack (or .rar)",
            filetypes=[("MCPE Skin Pack / RAR", "*.mcpack *.rar"), ("MCPE Skin Pack", "*.mcpack"), ("RAR Archive", "*.rar")]
        )
        if path:
            self.try_load(path)

    def open_folder(self):
        path = filedialog.askdirectory(title="Select folder containing skins.json")
        if path:
            self.try_load(path)

    def try_load(self, path):
        try:
            if os.path.isdir(path):
                self.load_pack_from_folder(path)
            else:
                self.load_pack(path)
        except Exception as e:
            messagebox.showerror(self.lang["load_error_title"], self.lang["load_error"].format(e))

    def load_pack_from_folder(self, folder_path):
        source_dir = None
        if os.path.isfile(os.path.join(folder_path, "skins.json")):
            source_dir = folder_path
        else:
            for entry in os.listdir(folder_path):
                sub = os.path.join(folder_path, entry)
                if os.path.isdir(sub) and os.path.isfile(os.path.join(sub, "skins.json")):
                    source_dir = sub
                    break
        if not source_dir:
            raise FileNotFoundError("skins.json not found in selected folder.")
        if self.temp_dir and os.path.isdir(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)
        self.temp_dir = tempfile.mkdtemp(prefix="mcpack_")
        for item in os.listdir(source_dir):
            src_item = os.path.join(source_dir, item)
            dst_item = os.path.join(self.temp_dir, item)
            if os.path.isdir(src_item):
                shutil.copytree(src_item, dst_item)
            else:
                shutil.copy2(src_item, dst_item)
        self.loaded_pack_path = folder_path
        self._load_skins_json_and_manifest(display_path=folder_path)

    def load_pack(self, path):
        lower = path.lower()
        if not (lower.endswith(".mcpack") or lower.endswith(".rar")):
            raise ValueError("Unsupported file type.")
        if self.temp_dir and os.path.isdir(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)
        self.temp_dir = tempfile.mkdtemp(prefix="mcpack_")
        if lower.endswith(".rar"):
            self._extract_from_rar(path)
        else:
            if not zipfile.is_zipfile(path):
                raise ValueError("File appears corrupted.")
            with zipfile.ZipFile(path, "r") as z:
                z.extractall(self.temp_dir)
        if not lower.endswith(".rar"):
            self.loaded_pack_path = path
        self._load_skins_json_and_manifest(display_path=path)

    def _load_skins_json_and_manifest(self, display_path):
        skins_json_path = os.path.join(self.temp_dir, "skins.json")
        manifest_path = os.path.join(self.temp_dir, "manifest.json")
        self.skins_data = []
        if os.path.isfile(skins_json_path):
            with open(skins_json_path, "r", encoding="utf-8-sig") as f:
                data = json.load(f)
                self.skins_data = data.get("skins", [])
        self.manifest = {}
        if os.path.isfile(manifest_path):
            try:
                with open(manifest_path, "r", encoding="utf-8-sig") as f:
                    self.manifest = json.load(f)
            except Exception:
                pass
        self._update_pack_label()
        self.render_skins()

    def _extract_from_rar(self, rar_path):
        if not RAR_AVAILABLE:
            raise RuntimeError("rarfile library required for RAR files.")
        rar_extract_dir = tempfile.mkdtemp(prefix="rar_extract_")
        try:
            with rarfile.RarFile(rar_path) as rf:
                rf.extractall(rar_extract_dir)
        except rarfile.RarCannotExec:
            chosen = filedialog.askopenfilename(title="Locate unrar.exe", filetypes=[("UnRAR", "*.exe"), ("All files", "*.*")])
            if not chosen:
                raise RuntimeError("unrar.exe not found.")
            rarfile.UNRAR_TOOL = chosen
            with rarfile.RarFile(rar_path) as rf:
                rf.extractall(rar_extract_dir)
        mcpack_path = None
        for root_dir, _, files in os.walk(rar_extract_dir):
            for fname in files:
                if fname.lower().endswith(".mcpack"):
                    mcpack_path = os.path.join(root_dir, fname)
                    break
            if mcpack_path:
                break
        if not mcpack_path:
            raise FileNotFoundError("No .mcpack found inside RAR.")
        with zipfile.ZipFile(mcpack_path, "r") as z:
            z.extractall(self.temp_dir)
        self.loaded_pack_path = mcpack_path
        shutil.rmtree(rar_extract_dir, ignore_errors=True)

    def _get_pack_display_name(self):
        try:
            name = self.manifest.get("header", {}).get("name")
            if name:
                return name
        except Exception:
            pass
        return "Unnamed Pack"

    def _update_pack_label(self):
        pack_name = self._get_pack_display_name()
        self.pack_label.config(
            text=self.lang["pack_label_format"].format(pack_name, len(self.skins_data)),
            fg="#343a40",
            font=("Segoe UI", 10, "bold")
        )

    def render_skins(self):
        for widget in self.scroll_frame.winfo_children():
            widget.destroy()
        self.thumbnails.clear()

        if not self.skins_data:
            tk.Label(
                self.scroll_frame,
                text=self.lang["no_skins"],
                font=("Segoe UI", 12),
                fg="#6c757d",
                bg="#f0f2f5"
            ).pack(pady=50)
            return

        cols = 4
        for idx, skin in enumerate(self.skins_data):
            texture_rel = skin.get("texture")
            display_name = skin.get("localization_name") or skin.get("name") or f"skin_{idx}"
            geometry = skin.get("geometry", "")

            frame = tk.Frame(
                self.scroll_frame,
                bg="#ffffff",
                relief="raised",
                bd=2,
                padx=8,
                pady=8
            )
            frame.grid(row=idx // cols, column=idx % cols, padx=12, pady=12, sticky="n")

            texture_path = os.path.join(self.temp_dir, texture_rel) if texture_rel else None
            thumb = self.make_thumbnail(texture_path)
            if thumb is not None:
                self.thumbnails.append(thumb)
                tk.Label(frame, image=thumb, bg="#ffffff").pack()
            else:
                tk.Label(frame, text=self.lang["no_image"], width=16, height=6, bg="#eee").pack()

            tk.Label(frame, text=display_name, font=("Segoe UI", 9, "bold"), bg="#ffffff", wraplength=130).pack()
            model_type = self.lang["model_slim"] if "slim" in geometry.lower() else (self.lang["model_classic"] if geometry else self.lang["model_unknown"])
            tk.Label(frame, text=f"Model: {model_type}", font=("Segoe UI", 8), fg="gray", bg="#ffffff").pack()

            edit_btn = tk.Button(
                frame,
                text=self.lang["btn_rename_skin"],
                font=("Segoe UI", 8, "bold"),
                bg="#e9ecef",
                fg="#495057",
                relief="flat",
                padx=4,
                pady=2,
                activebackground="#dee2e6",
                cursor="hand2",
                command=lambda i=idx: self.rename_skin(i)
            )
            edit_btn.pack(pady=3)

    def make_thumbnail(self, texture_path, max_size=110):
        if not texture_path or not os.path.isfile(texture_path):
            return None
        try:
            if PIL_AVAILABLE:
                img = Image.open(texture_path).convert("RGBA")
                img.thumbnail((max_size, max_size), Image.NEAREST)
                return ImageTk.PhotoImage(img)
            else:
                img = tk.PhotoImage(file=texture_path)
                if img.width() > max_size:
                    factor = max(1, img.width() // max_size)
                    img = img.subsample(factor, factor)
                return img
        except Exception:
            return None

    def find_com_mojang_dir(self):
        for raw_path in POSSIBLE_COM_MOJANG_PATHS:
            expanded = os.path.expandvars(raw_path)
            if os.path.isdir(expanded):
                return expanded
        return None

    def install_to_mcpe(self):
        if not self.temp_dir or not self.skins_data:
            messagebox.showwarning(self.lang["warning"], self.lang["install_warning"])
            return
        com_mojang = self.find_com_mojang_dir()
        if not com_mojang:
            messagebox.showinfo(self.lang["com_mojang_not_found"], self.lang["com_mojang_msg"])
            chosen = filedialog.askdirectory(title="Select com.mojang folder")
            if not chosen:
                return
            com_mojang = chosen
        resource_packs_dir = os.path.join(com_mojang, "resource_packs")
        os.makedirs(resource_packs_dir, exist_ok=True)
        pack_folder_name = self._safe_folder_name(self._get_pack_display_name())
        target_path = self._unique_target_path(resource_packs_dir, pack_folder_name)
        try:
            shutil.copytree(self.temp_dir, target_path)
        except Exception as e:
            messagebox.showerror(self.lang["export_error"], self.lang["install_error"].format(e))
            return
        messagebox.showinfo(self.lang["install_success"], self.lang["install_success_msg"].format(target_path))

    def _safe_folder_name(self, name):
        safe = "".join(c for c in name if c.isalnum() or c in " _-").strip()
        return safe or "SkinPack"

    def _unique_target_path(self, base_dir, folder_name):
        candidate = os.path.join(base_dir, folder_name)
        if not os.path.exists(candidate):
            return candidate
        suffix = uuid.uuid4().hex[:6]
        return os.path.join(base_dir, f"{folder_name}_{suffix}")

    def on_close(self):
        if self.temp_dir and os.path.isdir(self.temp_dir):
            shutil.rmtree(self.temp_dir, ignore_errors=True)
        self.root.destroy()


def main():
    root = TkinterDnD.Tk() if DND_AVAILABLE else tk.Tk()
    style = ttk.Style()
    style.theme_use("clam")
    app = SkinPackApp(root)
    root.protocol("WM_DELETE_WINDOW", app.on_close)
    root.mainloop()


if __name__ == "__main__":
    main()
