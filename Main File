class SkinPackApp:
    def __init__(self, root):
        self.root = root
        self.current_lang = "tr"
        try:
            sys_lang = locale.getdefaultlocale()[0]
            if sys_lang and sys_lang.startswith("en"):
                self.current_lang = "en"
        except:
            pass

        self.lang = LANGUAGES[self.current_lang]
        self.root.title(self.lang["title"])
        self.root.geometry("920x750")
        self.root.configure(bg="#f0f2f5")

        self.logo_image = None
        logo_path = os.path.join(os.path.dirname(__file__), "logo.png")
        if os.path.exists(logo_path) and PIL_AVAILABLE:
            try:
                img = Image.open(logo_path)
                img = img.resize((40, 40), Image.LANCZOS)
                self.logo_image = ImageTk.PhotoImage(img)
            except:
                self.logo_image = None

        self.temp_dir = None
        self.loaded_pack_path = None
        self.skins_data = []
        self.thumbnails = []
        self.manifest = {}

        self.build_ui()

        if DND_AVAILABLE:
            self.root.drop_target_register(DND_FILES)
            self.root.dnd_bind("<<Drop>>", self.on_drop)

        menubar = tk.Menu(self.root)
        lang_menu = tk.Menu(menubar, tearoff=0)
        lang_menu.add_command(label="Türkçe", command=lambda: self.change_lang("tr"))
        lang_menu.add_command(label="English", command=lambda: self.change_lang("en"))
        menubar.add_cascade(label="🌐 Language", menu=lang_menu)
        self.root.config(menu=menubar)

